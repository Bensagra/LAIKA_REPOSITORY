{
  "expo": {
    "name": "laikAI",
    "slug": "laikAI",
    "version": "1.0.0",
    "orientation": "landscape",
    "androidStatusBar": {
      "hidden": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.melinakenigsberg.laikAI",
      "usesCleartextTraffic": true,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "LAIKA necesita el micrófono para hablar por el parlante del robot."
      }
    },
    "extra": {
      "eas": {
        "projectId": "f4e76c39-da1f-43db-b200-8b73a2ece850"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withScreenRecord.js"
    ]
  }
}
