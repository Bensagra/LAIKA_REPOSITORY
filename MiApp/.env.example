# Copy to .env (or .env.local) for local dev, or set the same names in
# Vercel > Project Settings > Environment Variables for the deployed build.
# Any var left unset falls back to the dev defaults hardcoded in services/api.ts.

# Go2 robot media/command server (server_core.py). Must be reachable from
# wherever this app runs — a public IP:port if deployed, LAN IP if local.
EXPO_PUBLIC_DOG_API_URL=http://181.93.94.107:8000
EXPO_PUBLIC_DOG_TOKEN=dev-operator-token
EXPO_PUBLIC_DOG_ROBOT_ID=go2_01

# Missions/login backend (bUrl/dUrl in services/api.ts, ports 3000/3001).
# The current default (10.4.13.35) is a LAN address: unreachable once this
# app runs outside that network, e.g. once deployed on Vercel. Set this to a
# publicly reachable host, or leave unset and type one into the app's login
# screen at runtime (saved via setBackendHost/AsyncStorage).
EXPO_PUBLIC_BACKEND_HOST=10.4.13.35
