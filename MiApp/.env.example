# Copy to .env (or .env.local) for local dev, or set the same names in
# Vercel > Project Settings > Environment Variables for the deployed build.
# Any var left unset falls back to the dev defaults hardcoded in services/api.ts.

# Base URL for ALL robot/mission calls — points at the LAIKA backend
# (LAIKA_REPOSITORY's MELI---BACKEND---DEV branch), not the Go2 robot
# directly: that backend proxies live status/video/commands straight
# through to the robot, and owns mission storage itself (Postgres). The
# robot's own address below is only the dev fallback for when the backend
# isn't deployed yet — point this at wherever the backend actually runs.
EXPO_PUBLIC_DOG_API_URL=http://181.93.94.107:8000
EXPO_PUBLIC_DOG_TOKEN=dev-operator-token
EXPO_PUBLIC_DOG_ROBOT_ID=go2_01

# Supabase (auth + mission ownership/notes — see services/supabase.ts).
# Project Settings > API in the Supabase dashboard. The app throws at
# startup if either of these is missing.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key
